# Project Zephyr — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env

# Groq API key for LLM controller (required)
# Get one at: https://console.groq.com
GROQ_API_KEY=

# Frontend WebSocket URL (set for production, e.g. wss://your-app.fly.dev)
# Leave blank in local dev to auto-detect ws://localhost:8765
VITE_WS_URL=

# BrightData scraper (optional — falls back to OWM or static)
BRIGHTDATA_API_KEY=
BRIGHTDATA_DATASET_ID=

# OpenWeatherMap fallback (optional)
OWM_API_KEY=

# Backend config
WS_PORT=8765
TARGET_TEMP=22.0
TICK_INTERVAL=5
